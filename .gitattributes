# Normalização de fim de linha (Constituição, Princípio XI).
#
# Sem isto, um checkout em Windows marca ~113 arquivos como modificados só por
# CRLF/LF e o diff do PR fica ilegível — foi o que aconteceu no PR #1.
* text=auto eol=lf

# Scripts que precisam de CRLF para rodar no Windows.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binários: nunca converter.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
